# FalkorDB connection (matches docker-compose.yml defaults)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Leave empty for the local demo; set it and REDIS_ARGS=--requirepass in compose for protected instances
FALKORDB_PASSWORD=
FALKORDB_GRAPH=shelfsense

# Query safety
QUERY_TIMEOUT_MS=3000

# Fixed demo clock so delays/lookbacks are reproducible (IST, ISO-8601, no offset)
DEMO_NOW=2026-10-15T12:00:00
ORDER_LOOKBACK_DAYS=21

# Seed the graph on startup if it is empty (true/false)
SEED_ON_STARTUP=true

# Optional LLM summarisation. "none" = deterministic templates (default, no key required)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=20

# CORS origins for the local demo (comma separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
